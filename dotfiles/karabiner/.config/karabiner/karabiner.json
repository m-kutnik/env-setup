{
  "global": { "show_in_menu_bar": false },
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "cmd+qq -> close application",
            "manipulators": [
              {
                "conditions": [
                  {
                    "name": "command-q",
                    "type": "variable_if",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "q",
                  "modifiers": { "mandatory": ["command"] }
                },
                "to": [
                  {
                    "key_code": "q",
                    "modifiers": ["left_command"]
                  }
                ],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "q",
                  "modifiers": { "mandatory": ["command"] }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "command-q",
                      "value": 1
                    }
                  }
                ],
                "to_delayed_action": {
                  "to_if_canceled": [
                    {
                      "set_variable": {
                        "name": "command-q",
                        "value": 0
                      }
                    }
                  ],
                  "to_if_invoked": [
                    {
                      "set_variable": {
                        "name": "command-q",
                        "value": 0
                      }
                    }
                  ]
                },
                "type": "basic"
              }
            ]
          },
          {
            "description": "cmd+shift+f12 -> SIGKILL frontmost application",
            "manipulators": [
              {
                "from": {
                  "key_code": "f12",
                  "modifiers": { "mandatory": ["left_shift", "left_command"] }
                },
                "to": [
                  {
                    "shell_command": "killall -9 \"$(osascript -e 'tell application \"System Events\" to (name of (first process whose frontmost is true))')\""
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Disable cmd+tab -> prevent app switcher",
            "manipulators": [
              {
                "from": {
                  "key_code": "tab",
                  "modifiers": { "mandatory": ["command"] }
                },
                "to": [{ "key_code": "vk_none" }],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Disable cmd+h -> prevent minimising an application window",
            "manipulators": [
              {
                "from": {
                  "key_code": "h",
                  "modifiers": { "mandatory": ["command"] }
                },
                "type": "basic"
              }
            ]
          },
          {
            "description": "Disable cmd+option+h/m -> prevent minimising all windows",
            "manipulators": [
              {
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "mandatory": ["command", "option"],
                    "optional": ["any"]
                  }
                },
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "m",
                  "modifiers": {
                    "mandatory": ["command", "option"],
                    "optional": ["any"]
                  }
                },
                "type": "basic"
              }
            ]
          },
          {
            "description": "Swap Command and Option keys",
            "manipulators": [
              {
                "from": { "key_code": "left_command" },
                "to": [{ "key_code": "left_option" }],
                "type": "basic"
              },
              {
                "from": { "key_code": "left_option" },
                "to": [{ "key_code": "left_command" }],
                "type": "basic"
              },
              {
                "from": { "key_code": "right_command" },
                "to": [{ "key_code": "right_option" }],
                "type": "basic"
              },
              {
                "from": { "key_code": "right_option" },
                "to": [{ "key_code": "right_command" }],
                "type": "basic"
              }
            ]
          }
        ]
      },
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
    }
  ]
}
